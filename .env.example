# Vulnerability Management Pipeline - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=VulnerabilityManagementPipeline
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vuln_management
DB_USER=vmp_admin
DB_PASSWORD=changeme_secure_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Database URL (auto-constructed)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# REDIS CONFIGURATION (for Celery)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# OPENVAS CONFIGURATION
# =============================================================================
OPENVAS_HOST=openvas
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=changeme_openvas_password
OPENVAS_SOCKET=/run/gvmd/gvmd.sock

# =============================================================================
# NESSUS CONFIGURATION (Alternative Scanner)
# =============================================================================
NESSUS_HOST=localhost
NESSUS_PORT=8834
NESSUS_ACCESS_KEY=your_nessus_access_key_here
NESSUS_SECRET_KEY=your_nessus_secret_key_here
NESSUS_VERIFY_SSL=False

# =============================================================================
# JIRA INTEGRATION
# =============================================================================
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=VULN
JIRA_ENABLED=True

# =============================================================================
# THREAT INTELLIGENCE APIS
# =============================================================================
# NVD API (National Vulnerability Database)
NVD_API_KEY=your_nvd_api_key_here
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# EPSS (Exploit Prediction Scoring System)
EPSS_API_URL=https://api.first.org/data/v1/epss

# CISA KEV (Known Exploited Vulnerabilities)
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# =============================================================================
# RISK SCORING CONFIGURATION
# =============================================================================
# Weighting factors for risk score calculation (0-1, must sum to 1.0)
RISK_WEIGHT_CVSS=0.4
RISK_WEIGHT_EPSS=0.3
RISK_WEIGHT_ASSET_CRITICALITY=0.2
RISK_WEIGHT_REMEDIATION_DIFFICULTY=0.1

# SLA Deadlines (days)
SLA_CRITICAL_DAYS=7
SLA_HIGH_DAYS=30
SLA_MEDIUM_DAYS=90
SLA_LOW_DAYS=365

# =============================================================================
# SCANNING CONFIGURATION
# =============================================================================
SCAN_SCHEDULE_FULL=0 2 * * 0  # Weekly on Sunday at 2 AM
SCAN_SCHEDULE_INCREMENTAL=0 */4 * * *  # Every 4 hours
SCAN_SCHEDULE_WEB=0 */1 * * *  # Every hour
SCAN_TIMEOUT_SECONDS=14400  # 4 hours
SCAN_CONCURRENT_LIMIT=5

# =============================================================================
# REPORTING CONFIGURATION
# =============================================================================
REPORT_SCHEDULE=0 9 1 * *  # Monthly on 1st at 9 AM
REPORT_EMAIL_ENABLED=True
REPORT_EMAIL_FROM=security@company.com
REPORT_EMAIL_TO=executives@company.com,security-team@company.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=True

# =============================================================================
# FINANCIAL CALCULATIONS (Australian Market)
# =============================================================================
BREACH_COST_PER_RECORD_AUD=6400
AVG_RECORDS_PER_CRITICAL_ASSET=50000
REMEDIATION_COST_FACTOR_AUD=50000

# =============================================================================
# COMPLIANCE FRAMEWORKS
# =============================================================================
COMPLIANCE_FRAMEWORKS=NIST_800_53,ISO_27001,CIS_CONTROLS,PCI_DSS
ENABLE_COMPLIANCE_REPORTING=True

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=changeme_generate_secure_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HEADER=X-API-Key
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
GRAFANA_ENABLED=True
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# =============================================================================
# DATA RETENTION
# =============================================================================
RETAIN_SCAN_RESULTS_DAYS=365
RETAIN_RESOLVED_VULNS_DAYS=730
RETAIN_LOGS_DAYS=90
CLEANUP_SCHEDULE=0 3 * * 0  # Weekly on Sunday at 3 AM
